DOMAIN_NAME=ejemplo
APP_ENV=development
GRPC_PORT=50051

# Invariante: GRPC_MAX_WORKERS <= DB_POOL_SIZE + DB_MAX_OVERFLOW
# Con una sola Postgres el presupuesto de conexiones es COMPARTIDO entre todos los
# dominios: permanentes = Σ(dominios × DB_POOL_SIZE). Ver 04-base-de-datos.md.
GRPC_MAX_WORKERS=10
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=7

DATABASE_URL=postgresql://dev:dev@localhost:5432/plataforma

SENTRY_DSN=
