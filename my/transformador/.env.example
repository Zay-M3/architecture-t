# Copiar a .env y ajustar. El .env no se versiona.

# Dónde están los .proto que carga proto-loader en runtime.
# En local apuntan al dominio; dentro del contenedor, a /app/proto.
PROTO_ROOT=../dominios/todo/proto

# Host:puerto del dominio. En docker es el nombre del contenedor: dominio-todo:50051
TODO_GRPC_HOST=localhost:50051

# Servidor de Astro (los lee el adapter de node en runtime).
HOST=0.0.0.0
PORT=8000
